{
  "name": "webtabrec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:locales": "node scripts/validate-locales.mjs",
    "test": "node --test tests/unit/*.test.js tests/e2e/*.test.js",
